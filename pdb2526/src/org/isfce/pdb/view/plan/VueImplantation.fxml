<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Group?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.CheckBox?>

<BorderPane prefHeight="737.0" prefWidth="1122.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.isfce.pdb.view.plan.VueImplantationController">
   <center>
      <ScrollPane fx:id="scpCanvas" fitToHeight="true" fitToWidth="true" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
         <content>
            <Group fx:id="grpPane">
               <children>
                  <Pane fx:id="pane">
                     <children>
                        <Canvas fx:id="canvas" height="657.0" width="872.0" />
                     </children></Pane>
               </children>
            </Group>
         </content>
      </ScrollPane>
   </center>
   <bottom>
      <HBox alignment="CENTER_RIGHT" prefWidth="200.0" spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="btValider" mnemonicParsing="false" onAction="#actionValider" text="%action.ok" />
            <Button fx:id="btAnnuler" mnemonicParsing="false" onAction="#actionQuitter" text="%action.quitter" />
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </HBox>
   </bottom>
   <left>
    <VBox spacing="3" BorderPane.alignment="CENTER">
        <padding>
            <Insets top="5" right="5" bottom="5" left="5"/>
        </padding>
        <children>
            <Label text="Plan" style="-fx-font-family: Georgia; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 5 0 2 5;"/>
<ComboBox fx:id="cbPlans" maxWidth="1.7976931348623157E308" onAction="#actionChargePlan" prefWidth="150.0" />
<Label text="Pièce" style="-fx-font-family: Georgia; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 0 2 5;"/>
<ComboBox fx:id="cbPieces" maxWidth="1.7976931348623157E308" onAction="#actionFiltrePiece" prefWidth="150.0" />
<Separator style="-fx-padding: 5 0 5 0;"/>
<ListView fx:id="lstElements" prefHeight="585.0" prefWidth="200.0" />
<CheckBox fx:id="cbAfficherNoms" text="Afficher noms" selected="true" onAction="#actionToggleNoms"/>
        </children>
    </VBox>
</left>
</BorderPane>
