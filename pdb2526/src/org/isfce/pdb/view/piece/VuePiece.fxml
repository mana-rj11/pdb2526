<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefHeight="300.0" prefWidth="400.0"
    xmlns:fx="http://javafx.com/fxml/1"
    xmlns="http://javafx.com/javafx/23.0.1"
    fx:controller="org.isfce.pdb.view.piece.VuePieceController">
   <children>
      <Label styleClass="titre" text="%titre.piece.creer"
          AnchorPane.leftAnchor="5.0" AnchorPane.rightAnchor="5.0" AnchorPane.topAnchor="5.0" />
      <Label styleClass="main-label" text="%piece.nom"
          layoutY="60.0" AnchorPane.leftAnchor="5.0" AnchorPane.rightAnchor="200.0" AnchorPane.topAnchor="60.0" />
      <TextField fx:id="ztNom" styleClass="main-text-field"
          layoutY="60.0" AnchorPane.leftAnchor="200.0" AnchorPane.rightAnchor="5.0" AnchorPane.topAnchor="60.0" />
      <Label styleClass="main-label" text="%piece.description"
          layoutY="100.0" AnchorPane.leftAnchor="5.0" AnchorPane.rightAnchor="200.0" AnchorPane.topAnchor="100.0" />
      <TextField fx:id="ztDescription" styleClass="main-text-field"
          layoutY="100.0" AnchorPane.leftAnchor="200.0" AnchorPane.rightAnchor="5.0" AnchorPane.topAnchor="100.0" />
      <Label styleClass="main-label" text="%piece.etage"
          layoutY="140.0" AnchorPane.leftAnchor="5.0" AnchorPane.rightAnchor="200.0" AnchorPane.topAnchor="140.0" />
      <Spinner fx:id="spEtage"
          layoutY="140.0" AnchorPane.leftAnchor="200.0" AnchorPane.rightAnchor="5.0" AnchorPane.topAnchor="140.0" />
      <Label styleClass="main-label" text="%piece.typePiece"
          layoutY="180.0" AnchorPane.leftAnchor="5.0" AnchorPane.rightAnchor="200.0" AnchorPane.topAnchor="180.0" />
      <ComboBox fx:id="cbTypePiece"
          layoutY="180.0" AnchorPane.leftAnchor="200.0" AnchorPane.rightAnchor="5.0" AnchorPane.topAnchor="180.0" />
      <HBox alignment="CENTER_RIGHT" spacing="10.0"
          AnchorPane.bottomAnchor="5.0" AnchorPane.leftAnchor="5.0" AnchorPane.rightAnchor="5.0">
         <children>
            <Button onAction="#actionValider" text="%action.ok" />
            <Button onAction="#actionAnnuler" text="%action.annuler" />
         </children>
         <padding><Insets bottom="5.0" left="5.0" right="5.0" top="5.0" /></padding>
      </HBox>
   </children>
</AnchorPane>