<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane prefHeight="500.0" prefWidth="700.0"
    xmlns:fx="http://javafx.com/fxml/1"
    xmlns="http://javafx.com/javafx/23.0.1"
    fx:controller="org.isfce.pdb.view.element.VueListeElementsController">
   <center>
      <TableView fx:id="tblElements">
        <columns>
          <TableColumn fx:id="colCode" text="%element.code" prefWidth="80.0" />
          <TableColumn fx:id="colInfo" text="%element.info" prefWidth="180.0" />
          <TableColumn fx:id="colAppareil" text="%element.appareil" prefWidth="180.0" />
          <TableColumn fx:id="colQt" text="%element.qt" prefWidth="50.0" />
          <TableColumn fx:id="colPiece" text="%element.piece" prefWidth="150.0" />
        </columns>
      </TableView>
   </center>
   <bottom>
      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <children>
            <Button fx:id="btRecharger" onAction="#actionRecharger" text="%action.reload" />
            <Button fx:id="btQuitter" onAction="#actionQuitter" text="%action.quitter" />
         </children>
         <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
      </HBox>
   </bottom>
</BorderPane>